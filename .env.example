# ============ REQUIRED ============

# Session signing secret — at least 32 characters.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ============ OPTIONAL ============

# Host-side port mapping (container always listens on 3000 internally).
PORT=3000

# True when behind a TLS-terminating reverse proxy (Traefik / Nginx / Caddy).
# - Sets the Secure flag on session cookies
# - Trusts X-Forwarded-* headers for client IP / proto
BEHIND_PROXY=true

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# Timezone for log timestamps inside the container.
TZ=Europe/Amsterdam
